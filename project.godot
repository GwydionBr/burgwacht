; Engine configuration file.

config_version=5

[application]

config/name="Burgwacht"
config/description="Burgenbau-Strategiespiel im Stil von Stronghold"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.09, 0.1, 0.09, 1)
textures/vram_compression/import_etc2_astc=true

[debug]

gdscript/warnings/untyped_declaration=2

[editor_plugins]

enabled=PackedStringArray("res://addons/presets/plugin.cfg")

[importer_defaults]

texture={
"mipmaps/generate": true
}
